<?xml version="1.0" encoding="UTF-8"?>
<!-- Kopyala: ~/Library/LaunchAgents/space.flyteq.whatsapp-ilk-mesaj.plist
     Sonra: launchctl load ~/Library/LaunchAgents/space.flyteq.whatsapp-ilk-mesaj.plist
     Her gün 10:15'te çalışır; gonder.mjs kendi içinde Pazar + saat penceresini eler. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>space.flyteq.whatsapp-ilk-mesaj</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/ahmetfarukdogan/Desktop/flyteq son/otomasyon/whatsapp-ilk-mesaj/calistir.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>10</integer>
    <key>Minute</key><integer>15</integer>
  </dict>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- Notion token'ı ya buraya yaz ya da
         otomasyon/whatsapp-ilk-mesaj/.notion-token dosyasına koy (gitignore'lu). -->
    <key>NOTION_TOKEN</key>
    <string>BURAYA_NOTION_TOKEN</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/flyteq-whatsapp-ilk-mesaj.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/flyteq-whatsapp-ilk-mesaj.err</string>
</dict>
</plist>
